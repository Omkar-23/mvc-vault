@model studentdb.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<h1>Delete Student</h1>

<div class="alert alert-warning">
    <h4>Are you sure you want to delete this student?</h4>
</div>

<div class="student-details">
    <dl class="row">
        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>

        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.LastName</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Enrollment Date</dt>
        <dd class="col-sm-10">@Model.EnrollmentDate.ToShortDateString()</dd>

        @if(Model.DateOfBirth.HasValue)
        {
            <dt class="col-sm-2">Date of Birth</dt>
            <dd class="col-sm-10">@Model.DateOfBirth.Value.ToShortDateString()</dd>
        }

        <dt class="col-sm-2">GPA</dt>
        <dd class="col-sm-10">@Model.GPA?.ToString("0.00")</dd>
    </dl>
    
    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="StudentId" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Confirm Delete
        </button>
        <a asp-action="Index" class="btn btn-secondary ml-2">
            <i class="bi bi-arrow-left"></i> Cancel
        </a>
    </form>
</div>